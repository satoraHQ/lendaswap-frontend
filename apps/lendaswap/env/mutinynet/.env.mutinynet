# Public frontend settings only. Never put secrets in VITE_* variables.
# Run from the repo root:
# pnpm --dir frontend/apps/lendaswap dev:mutinynet
# Vite uses this isolated directory; the root .env is not loaded.
# Uses the hosted Mutinynet backend; no local backend is required.
# EVM networks and tokens are determined by that backend, not this file.
VITE_APP_ENV=mutinynet
VITE_LENDASWAP_API_URL=https://mutinynet-api.satora.io
VITE_BITCOIN_NETWORK=signet
VITE_ESPLORA_URL=https://mutinynet.com/api
VITE_ARKADE_URL=https://mutinynet.arkade.sh
# No mainnet Electrum or account-abstraction services in this profile.
VITE_ELECTRUM_WS_URL=
VITE_AA_BUNDLER_URL=
VITE_AA_POLICY_ID=
VITE_AA_RPC_URL=
VITE_RPC_OVERRIDES=
VITE_RPC_OVERRIDE_CHAIN_ID=
VITE_RPC_OVERRIDE_URL=
VITE_DEBUG_MODE=true

# Production Arbitrum USDT0 funding, Mutinynet Bitcoin payouts.
VITE_PAY_DEFAULT_SOURCE=42161:0xfd086bc7cd5c481dcc9c85ebe478a1c0b69fcbb9
