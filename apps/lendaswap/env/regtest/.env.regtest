# Local regtest stack: regtest bitcoind/esplora/arkd plus Anvil forks of
# Polygon (8545) and Arbitrum (8546), and the swap daemon on 3333.
# Bring it up with `just e2e-setup`, then run from the repo root:
#   pnpm --dir frontend/apps/lendaswap dev:regtest
# Fund a wallet or Pay deposit address: just e2e fund-evm <address> 250
# Mine Bitcoin blocks: just mine 1
# Public settings only; Vite uses this isolated directory.
VITE_APP_ENV=regtest
VITE_LENDASWAP_API_URL=http://localhost:3333
VITE_BITCOIN_NETWORK=regtest
VITE_ESPLORA_URL=http://localhost:3000/api
VITE_ARKADE_URL=http://localhost:7070
VITE_ELECTRUM_WS_URL=
# Wallet transports and SDK chain reads go to the forks.
VITE_RPC_OVERRIDES=42161=http://localhost:8546,137=http://localhost:8545
# No hosted account-abstraction services; gasless funding uses the server relay.
VITE_AA_BUNDLER_URL=
VITE_AA_POLICY_ID=
VITE_AA_RPC_URL=
VITE_DEBUG_MODE=true
VITE_POSTHOG_DISABLED=true

# Arbitrum USDT0 on the fork funds Pay by default.
VITE_PAY_DEFAULT_SOURCE=42161:0xfd086bc7cd5c481dcc9c85ebe478a1c0b69fcbb9
